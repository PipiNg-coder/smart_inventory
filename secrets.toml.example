# .streamlit/secrets.toml  (KHÔNG đưa file thật lên GitHub)
[gcp_service_account]
# ... các trường của Service Account JSON (dùng để Streamlit đọc BigQuery) ...

[api]
# Địa chỉ FastAPI sau khi triển khai (không có dấu / ở cuối). Chạy trên máy thì bỏ cả mục này (mặc định http://127.0.0.1:8000).
base_url = "https://shelfsense-api-xxxxx.a.run.app"
# Khóa API (trùng với SHELFSENSE_API_KEY đặt ở máy chủ API). Có thể để trống khi chạy thử trên máy.
key = ""
